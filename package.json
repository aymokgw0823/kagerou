{
  "name": "kagerou",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/build-fonts.ts && tsx scripts/build-search-index.ts && tsx scripts/check-dummy.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:dummy": "tsx scripts/check-dummy.ts",
    "gen:placeholders": "tsx scripts/generate-placeholders.ts",
    "check": "npm run lint && npm run typecheck && npm run test",
    "build:search-index": "tsx scripts/build-search-index.ts",
    "seed:articles": "tsx scripts/seed-articles.ts --clean",
    "predev": "tsx scripts/build-fonts.ts && tsx scripts/build-search-index.ts",
    "postinstall": "prisma generate && tsx scripts/build-fonts.ts",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "check:dummy:md": "tsx scripts/check-dummy.ts --md",
    "build:fonts": "tsx scripts/build-fonts.ts",
    "photo:prompts": "tsx scripts/photo-prompts.ts",
    "photo:import": "tsx scripts/import-photos.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@fontsource/open-sans": "^5.3.0",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-pdf/renderer": "^4.9.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.8",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "motion": "^14.5.0",
    "next": "16.4.2",
    "next-mdx-remote": "^6.0.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@rolldown/binding-darwin-arm64": "^1.2.14",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
