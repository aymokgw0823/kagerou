# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local db / env
*.db
*.db-journal
.env*.local

# playwright
/test-results/
/playwright-report/

# generated search index
/public/search-index.json

# prisma generated client
/src/generated/
# uploaded files (local storage)
/uploads/

# generated fonts
/public/fonts/

# Vercel / Neon の skills インストーラーが置くファイル
/.agents/
/.claude/skills/
/skills-lock.json

# Finder / 同期の複製ファイル（"xxx 2.ts" など）
* [0-9].*
