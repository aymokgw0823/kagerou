# ──────────────────────────────────────────────────────────────
# 環境変数一覧（.env.local にコピーして使う。すべて任意：未設定でもデモモードで動く）
# ──────────────────────────────────────────────────────────────

# ── サイト ──
# 本番URL（canonical・OGP・sitemap・JSON-LD に使用）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 本番ビルドでも DUMMY / PLACEHOLDER バッジを表示する（プレビュー環境向け）
NEXT_PUBLIC_SHOW_DUMMY_BADGES=false
# check-dummy を厳格モードにし、差し替え漏れがあればビルドを失敗させる（1 で有効）
CHECK_DUMMY_STRICT=0

# ── AI（Phase 5）──
# 未設定なら AI 機能はモック応答の「デモモード」で動作する
ANTHROPIC_API_KEY=
# 対話・診断に使うモデル
ANTHROPIC_MODEL=claude-sonnet-5-5
# PDFレポート生成など重い処理に使うモデル
ANTHROPIC_MODEL_HEAVY=claude-opus-5-5
# 日次トークン上限。超過時は「本日の受付は終了しました」を表示
AI_DAILY_TOKEN_BUDGET=2000000
# レート制限：1時間あたりの回数（IP単位／セッション単位）
AI_RATE_LIMIT_PER_HOUR=10
# 意味検索（Voyage AI 等）を有効化する機能フラグ。インターフェースのみ用意
AI_SEMANTIC_SEARCH_ENABLED=false
VOYAGE_API_KEY=

# ── データベース ──
# 開発: SQLite（file:./dev.db）/ 本番: PostgreSQL（postgres://…）。
# PostgreSQL に切り替えるときは prisma/schema.prisma の provider を "postgresql" に変更して migrate する
DATABASE_URL="file:./dev.db"

# ── 管理画面（Phase 5）──
ADMIN_USER=admin
ADMIN_PASSWORD=
# セッション署名用のランダム文字列（32文字以上）
ADMIN_SESSION_SECRET=

# ── メール（未設定時はコンソールに出力）──
MAIL_FROM=noreply@example.com
# お問い合わせ・予約の通知先（未設定なら MAIL_FROM）
MAIL_TO_CONTACT=
# 採用エントリーの通知先（未設定なら MAIL_TO_CONTACT）
MAIL_TO_RECRUIT=
# Resend（https://resend.com）の API キー。設定すると実際に送信する
RESEND_API_KEY=

# ── フォームのスパム対策 ──
# Cloudflare Turnstile（任意）。両方を設定すると CAPTCHA が有効になる
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# 履歴書などのアップロード先ディレクトリ（既定 ./uploads。git 管理外）
UPLOAD_DIR=

# ── 計測（Phase 6）──
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=

# ── 地図・外部サービス ──
# Google Maps 埋め込み（未設定なら静的地図）
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
# 外部日程調整サービスの埋め込みURL（TimeRex / Calendly 等。未設定なら自前の簡易予約）
NEXT_PUBLIC_BOOKING_EMBED_URL=
